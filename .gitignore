_img/
.DS_Store

# PDFs are derived from .typ — generated on demand, not versioned (coherente con consumers)
*.pdf

# Cortex (generated cache — do not commit)
# Contents-only (not the directory itself), so a nested vault's .gitignore
# (or the negation below) can re-include specific paths under a .cortex/ —
# git will not let a later `!` pattern re-include anything whose PARENT
# DIRECTORY is excluded, only its contents, so excluding the directory
# outright here would make any such negation a no-op.
**/.cortex/*
# bench's CI fixture force-tracks its query-embedding store so offline CI
# never regenerates it; the negation must survive a regenerated store
# gaining a new or renamed file, not just cover the file committed today.
!bench/fixtures/ci-vault/.cortex/embeddings/

# Scratch / tooling working dirs (not part of the repo)
.playwright-mcp/
__pycache__/

# Internal design docs & agent tooling — never published (portable rule, was in .git/info/exclude)
docs/superpowers/
.superpowers/

# Dependency and tool caches, anywhere. `bench/node_modules/` alone left the
# repo root uncovered, and running a test runner from the root creates one
# there (a bare `.vite` cache) — untracked, easy to commit by accident.
node_modules/

# Bench build artifacts
bench/out/
bench/fixtures/ci-vault/.cortex/models/
bench/fixtures/ci-vault/.cortex/backups/

# Public benchmark corpus — fetched, never vendored. 398 files of CC BY 4.0
# documentation belonging to someone else; bench/scripts/fetch-public-corpus.mjs
# pins the commit, which gives reproducibility without redistribution.
bench/corpora/
